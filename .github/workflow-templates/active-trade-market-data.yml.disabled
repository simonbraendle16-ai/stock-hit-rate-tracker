# PREPARED ONLY. Not an active GitHub workflow. No Phase-2 deployment/activation.
name: Active trade market data
on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: active-trade-market-data
  cancel-in-progress: false
jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - name: Collect market data only
        env:
          APP_URL: ${{ secrets.APP_URL }}
          CRON_SECRET: ${{ secrets.CRON_SECRET }}
        run: |
          curl --fail --silent --show-error --max-time 65 \
            --output report.json --header "Authorization: Bearer $CRON_SECRET" \
            "$APP_URL/api/cron/collect-candles"
          jq '{ok, ran, skipped, seriesDue, seriesFetched, seriesFailed, error}' report.json
          jq -e '.ok == true' report.json > /dev/null
